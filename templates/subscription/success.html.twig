{% extends 'base.html.twig' %}

{% block title %}Souscription confirmée{% endblock %}

{% block body %}
<div style="max-width: 720px; margin: 40px auto;">

  <h1> Souscription confirmée</h1>

  <hr>

  <h3>Informations</h3>

  <p><strong>Client :</strong> {{ subscription.clientName }}</p>
  <p><strong>Email :</strong> {{ subscription.clientEmail }}</p>
  <p><strong>Forfait :</strong> {{ subscription.offerType.value }}</p>
  <p><strong>Domaine :</strong> {{ subscription.domain }}</p>

  <p>
    <strong>Statut :</strong>
    <span style="font-weight:bold;">
      {{ subscription.status.value }}
    </span>
  </p>

  <hr>

  {% if subscription.status.value in ['pending','provisioning','configuring','deploying'] %}
    <div style="padding:15px; background:#fff3cd; border-radius:6px;"> Votre instance est en cours de déploiement.<br>
      Cela peut prendre quelques minutes.
    </div>

    <div style="margin-top:20px;">
      <a href="{{ path('app_subscription_success', {id: subscription.id}) }}"
         style="padding:8px 14px; background:#007bff; color:white; text-decoration:none; border-radius:4px;"> Actualiser le statut
      </a>
    </div>
  {% endif %}

  {% if subscription.status.value == 'ready' %}
    <div style="padding:15px; background:#d4edda; border-radius:6px;"> Votre instance est prête !
    </div>

    <div style="margin-top:20px;">
      <a href="https://{{ subscription.domain }}"
         target="_blank"
         style="padding:8px 14px; background:#28a745; color:white; text-decoration:none; border-radius:4px;">Accéder à mon instance
      </a>
    </div>
  {% endif %}

  {% if subscription.status.value == 'error' %}
    <div style="padding:15px; background:#f8d7da; border-radius:6px;"> Une erreur est survenue :<br>
      {{ subscription.errorMessage }}
    </div>
  {% endif %}

  <hr>

  <div style="margin-top:30px;">
    <a href="{{ path('app_subscription_new') }}"> Créer une autre souscription
    </a>
  </div>

</div>
{% endblock %}
